DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678

# --- Optional: channel configuration via env vars ---
# These override channels.json / config.json, which is useful on
# platforms like Railway where the container filesystem is ephemeral.

# Comma-separated list of to-do channel IDs (the pool /pick-todo picks from)
TODO_CHANNEL_IDS=

# Single channel ID where completed threads are moved (text or forum channel)
COMPLETED_CHANNEL_ID=

# Legacy single-channel setting (auto-migrated into channels.json on first run).
# Prefer TODO_CHANNEL_IDS above.
TODO_CHANNEL_ID=
